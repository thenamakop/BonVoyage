<mxfile host="app.diagrams.net" agent="BonVoyage Design Lab" version="24.0.0"><diagram name="2.1 DFD Elements" id="el"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="el-v1" value="&lt;b&gt;Task 2.1: Identification of DFD Elements&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=26;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="el-v2" value="Processes, data stores, external entities and data flows of the BonVoyage system. Both DFD levels are generated from this single specification, which guarantees balancing." style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;spacing=4;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="2300" height="30" as="geometry"/></mxCell><mxCell id="el-v3" value="&lt;div style='font-weight:bold;font-size:17px;margin-bottom:6px;'&gt;Table 2.1(a): External entities&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:16px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:16%;'&gt;Entity&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:32%;'&gt;Role&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:26%;'&gt;Data supplied to the system&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:26%;'&gt;Data received from the system&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Group Member&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Registered participant who submits preferences and decides on packages and itineraries.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;account credentials; preference profile &amp;amp; past trips; package &amp;amp; itinerary decisions&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;trip invitation; trip packages &amp;amp; cost breakdown; day-wise itinerary; notifications &amp;amp; trip history&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Trip Organiser&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Member who creates the trip, sets group parameters and selects a destination.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;trip details &amp;amp; member list; destination selection&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;preference conflict report; ranked shortlist or diagnostic&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;System Administrator&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Maintains the destination catalogue and fallback datasets.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;catalogue &amp;amp; fallback data updates&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;catalogue status report&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Maps &amp;amp; Routing Service&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;External provider of routes, distances and place reference data.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;route &amp;amp; distance data; reference place data&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;route &amp;amp; distance query&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Hotel &amp;amp; Fare Provider&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;External provider of accommodation options and indicative fares.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;hotel &amp;amp; fare data&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;hotel &amp;amp; fare query&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Language Model Service&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;External provider that composes itinerary text from grounded facts.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;composed itinerary text&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;grounded itinerary prompt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1220" height="430" as="geometry"/></mxCell><mxCell id="el-v4" value="&lt;div style='font-weight:bold;font-size:17px;margin-bottom:6px;'&gt;Table 2.1(b): Processes (Level 1)&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:16px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:7%;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:30%;'&gt;Process&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:63%;'&gt;Responsibility&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;1.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Manage Accounts &amp;amp; Trip Groups&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Registers and authenticates users, creates trips and records membership.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;2.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Collect Preferences &amp;amp; Availability&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Captures each member's structured preference profile and past trips.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;3.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Aggregate Group Profile&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Builds the group model, computes the common window and detects conflicts.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;4.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Recommend Destinations&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Filters by hard constraints, ranks by group-fit score and explains results.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;5.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Generate &amp;amp; Cost Packages&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Assembles transport and stay options with an itemised cost breakdown.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;6.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Generate Itinerary&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Composes a day-wise plan from verified facts for the accepted package.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;7.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Record Decisions &amp;amp; Notify&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Stores accept, modify and reject decisions and issues notifications.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;8.0&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Maintain Destination Catalogue&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Updates catalogue entries and curated fallback data.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1220" height="360" as="geometry"/></mxCell><mxCell id="el-v5" value="&lt;div style='font-weight:bold;font-size:17px;margin-bottom:6px;'&gt;Table 2.1(c): Data stores&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:16px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:7%;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:22%;'&gt;Data store&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:43%;'&gt;Contents&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:14%;'&gt;Written by&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:14%;'&gt;Read by&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;D1&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;User Accounts&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;User identity, credentials (salted hash) and home city.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;1.0&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;1.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;D2&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Trips &amp;amp; Memberships&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Trip parameters, members, roles and invitation status.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;1.0&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;2.0, 3.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;D3&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Preference Profiles&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Destination types, activities, budget range, availability, past trips.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;2.0&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;3.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;D4&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Destination Catalogue&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Destinations, coordinates, cost bands and fallback fare data.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;8.0&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;4.0, 5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;D5&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Packages &amp;amp; Cost Items&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Generated packages, cost lines and decision status.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;5.0, 7.0&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;6.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;D6&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;Itineraries&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Day-wise itineraries, edits, decisions and trip history.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;6.0, 7.0&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;7.0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1220" height="330" as="geometry"/></mxCell><mxCell id="el-v6" value="&lt;div style='font-weight:bold;font-size:17px;margin-bottom:6px;'&gt;Table 2.1(d): External data flows (identical at Level 0 and Level 1)&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:16px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:36%;'&gt;Data flow&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:32%;'&gt;Source&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:32%;'&gt;Destination&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;account credentials&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Group Member&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;1.0 Manage Accounts &amp;amp; Trip Groups&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;trip invitation&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;1.0 Manage Accounts &amp;amp; Trip Groups&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Group Member&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;preference profile &amp;amp; past trips&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Group Member&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;2.0 Collect Preferences &amp;amp; Availability&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;trip packages &amp;amp; cost breakdown&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;5.0 Generate &amp;amp; Cost Packages&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-a