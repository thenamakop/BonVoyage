-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Itinerary Proposed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T13&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Itinerary Proposed&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;itineraryRejected&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Package Selected&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T14&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Itinerary Proposed&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;itineraryAccepted&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Finalised&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T15&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Planning (any substate)&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;cancelTrip&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Cancelled&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T16&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Finalised&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;cancelTrip&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;[now &amp;lt; startDate]&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Cancelled&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T17&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Finalised&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;at(startDate)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;In Progress&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T18&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;In Progress&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;at(endDate)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;requestRatings&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Completed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T19&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Completed&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;&lt;i&gt;completion&lt;/i&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;final state&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;T20&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Cancelled&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;&lt;i&gt;completion&lt;/i&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;final state&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:15px;margin-top:10px;line-height:1.45;'&gt;&lt;b&gt;Internal transitions&lt;/b&gt; (fire without exit or re-entry): &lt;i&gt;preferenceSubmitted [pending &amp;gt; 0] / updateProgress&lt;/i&gt; in Collecting Preferences; &lt;i&gt;packageModified / recomputeCost&lt;/i&gt; and &lt;i&gt;packageRejected [alternatives left] / hidePackage&lt;/i&gt; in Packages Proposed; &lt;i&gt;itineraryModified / revalidate&lt;/i&gt; in Itinerary Proposed. By contrast T5 is a true self-transition: re-entering Ready for Recommendation reruns its entry action, so revised preferences always rebuild the group profile.&lt;/div&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="1230" height="1280" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4.4 State Transition Diagram" id="st"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2880" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st-v1" value="&lt;b&gt;BonVoyage: State Transition Diagram (UML State Machine) of the Trip entity&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=26;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="st-v2" value="Transitions are labelled event [guard] / action. Lines inside a state are its entry or do behaviour and its internal transitions, which fire without leaving the state." style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;spacing=4;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="2000" height="30" as="geometry"/></mxCell><mxCell id="st-PLAN" value="Planning" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;s