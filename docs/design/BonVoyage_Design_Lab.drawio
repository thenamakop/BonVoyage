e d]&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;spacing=4;fontColor=#1e1e1e;" vertex="1" parent="1"><mxGeometry x="1268" y="544" width="700" height="28" as="geometry"/></mxCell><mxCell id="sq-v58" value="opt" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeWidth=1.4;fontSize=15;fontStyle=1;width=70;height=30;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1500" y="624" width="542" height="210" as="geometry"/></mxCell><mxCell id="sq-v59" value="&lt;b&gt;[distance not in cache]&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;spacing=4;fontColor=#1e1e1e;" vertex="1" parent="1"><mxGeometry x="1580" y="626" width="700" height="28" as="geometry"/></mxCell><mxCell id="sq-v60" value="alt" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeWidth=1.4;fontSize=15;fontStyle=1;width=70;height=30;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="1048" width="2444" height="650" as="geometry"/></mxCell><mxCell id="sq-v61" value="&lt;b&gt;[feasible.size() &amp;gt;= 3]&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;spacing=4;fontColor=#1e1e1e;" vertex="1" parent="1"><mxGeometry x="160" y="1050" width="700" height="28" as="geometry"/></mxCell><mxCell id="sq-e62" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=#1e1e1e;fontColor=#1e1e1e;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeWidth=1.4;dashPattern=8 6;" edge="1" parent="1"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint x="80" y="1492" as="sourcePoint"/><mxPoint x="2524" y="1492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq-v63" value="&lt;b&gt;[else]&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;spacing=4;" vertex="1" parent="1"><mxGeometry x="86" y="1496" width="80" height="28" as="geometry"/></mxCell><mxCell id="sq-v64" value="Realises the &lt;b&gt;&amp;laquo;extend&amp;raquo;&lt;/b&gt; use case &lt;b&gt;Show Empty Shortlist Diagnostic&lt;/b&gt; (fewer than three feasible destinations)." style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;shape=note;size=16;fillColor=#fff9db;fontSize=14;align=left;verticalAlign=top;spacing=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1632" y="1514" width="248" height="104" as="geometry"/></mxCell><mxCell id="sq-v65" value="&lt;div style='padding:10px 14px;'&gt;&lt;div style='font-size:18px;font-weight:bold;margin-bottom:6px;'&gt;Task 3.1: Selected use case&lt;/div&gt;&lt;div style='font-size:15px;margin-bottom:10px;'&gt;&lt;b&gt;Recommend Destinations&lt;/b&gt; (primary actor: Trip Organiser). Chosen because it is the core of the system and exercises both kinds of use case relationship: it &lt;i&gt;includes&lt;/i&gt; Filter by Hard Constraints and Rank by Group-Fit Score, and is &lt;i&gt;extended&lt;/i&gt; by Show Empty Shortlist Diagnostic.&lt;/div&gt;&lt;div style='font-size:18px;font-weight:bold;margin:8px 0 6px;'&gt;Task 3.2: Participating objects&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:14px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#ffffff;width:36%;vertical-align:top;'&gt;&lt;b&gt;Trip Organiser&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;actor&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;Primary actor. Initiates the use case and receives the shortlist or the diagnostic.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#b2f2bb;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Web Client&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;boundary&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;Presentation layer. Captures the request and renders the result.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#a5d8ff;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Recommendation Controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;control&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;Orchestrates the use case: loads data, calls the modules, decides between the two outcomes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#ffec99;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Database&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;entity&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;PostgreSQL store holding the group profile (D2, D3), the catalogue (D4) and saved shortlists.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#a5d8ff;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Filtering Module&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;control&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;Geospatial and Filtering Module. Enforces the radius, budget, duration and date constraints.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#a5d8ff;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Data Integration Module&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;control&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;Mediates all third-party calls; serves cached distances and caches new ones.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#d0bfff;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Maps &amp;amp; Routing Service&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;external&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;External system returning road distance and travel time.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;background:#a5d8ff;width:36%;vertical-align:top;'&gt;&lt;b&gt;:Recommendation Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;laquo;control&amp;raquo;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:4px 6px;vertical-align:top;'&gt;Computes the group-fit score for each feasible destination and builds explanations.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:18px;font-weight:bold;margin:12px 0 6px;'&gt;Notation&lt;/div&gt;&lt;div style='font-size:14px;line-height:1.5;'&gt;Solid line, filled head: synchronous call&lt;br&gt;Dashed line, open head: return message&lt;br&gt;White bar: execution specification (activation)&lt;br&gt;Frames: &lt;b&gt;loop&lt;/b&gt; iteration, &lt;b&gt;opt&lt;/b&gt; optional, &lt;b&gt;alt&lt;/b&gt; alternatives, each with a guard in brackets&lt;br&gt;Participants are ordered left to right by first use.&lt;/div&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#868e96;dashed=1;" vertex="1" parent="1"><mxGeometry x="2600" y="130" width="500" height="820" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4.1-4.3 States and Events" id="stt"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="stt-v1" value="&lt;b&gt;Tasks 4.1 to 4.3: Entity, states and triggering events&lt;/b&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=26;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="stt-v2" value="&lt;div style='font-size:17px;font-weight:bold;margin-bottom:6px;'&gt;Task 4.1: Chosen entity: Trip&lt;/div&gt;&lt;div style='font-size:16px;line-height:1.45;'&gt;A &lt;b&gt;Trip&lt;/b&gt; is the object whose behaviour depends most on its history. The same event is legal in one state and meaningless in another: a member can accept a package only while packages are proposed, and &lt;i&gt;cancelTrip&lt;/i&gt; is allowed throughout planning but only before the start date once the plan is finalised. Its lifecycle also traces the whole use case chain, from Manage Trip Group through Review and Decide on Itinerary to View Trip History, so the state machine doubles as a check that the use cases connect.&lt;/div&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2480" height="150" as="geometry"/></mxCell><mxCell id="stt-v3" value="&lt;div style='font-size:17px;font-weight:bold;margin-bottom:6px;'&gt;Task 4.2: States of Trip&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:15px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:5%;'&gt;#&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:25%;'&gt;State&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:44%;'&gt;Meaning&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:26%;'&gt;Entry / do behaviour&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S1&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;'&gt;&lt;b&gt;Draft&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Trip created by the organiser; parameters editable, no members yet.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / validateTripParameters&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S2&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#a5d8ff;'&gt;&lt;b&gt;Collecting Preferences&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Invitations sent; members submit profiles, availability and past trips.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / openSubmissionWindow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S3&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#a5d8ff;'&gt;&lt;b&gt;Ready for Recommendation&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Every member has submitted; the group profile and common window are computed.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / computeGroupProfile&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S4&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#b2f2bb;'&gt;&lt;b&gt;Shortlisted&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;At least three feasible destinations ranked by group-fit score.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / saveRankedShortlist&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S5&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#b2f2bb;'&gt;&lt;b&gt;Packages Proposed&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Costed packages for the chosen destination are under group review.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / generateAndCostPackages&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S6&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#b2f2bb;'&gt;&lt;b&gt;Package Selected&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;The group has accepted one package; its facts are frozen for itinerary generation.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / lockPackage&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S7&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#b2f2bb;'&gt;&lt;b&gt;Itinerary Proposed&lt;/b&gt;&lt;i&gt; (substate of Planning)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;A day-wise plan grounded in the package is under group review.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / assembleDayWisePlan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S8&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#ffec99;'&gt;&lt;b&gt;Finalised&lt;/b&gt;&lt;i&gt;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Plan confirmed by the group; waiting for the travel start date.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / notifyMembers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S9&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#ffec99;'&gt;&lt;b&gt;In Progress&lt;/b&gt;&lt;i&gt;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;The trip is under way.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;do&lt;/b&gt; / sendDailyReminders&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S10&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#ffec99;'&gt;&lt;b&gt;Completed&lt;/b&gt;&lt;i&gt;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Trip ended; ratings requested and stored as past-trip data.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / archiveToTripHistory&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;S11&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#ffc9c9;'&gt;&lt;b&gt;Cancelled&lt;/b&gt;&lt;i&gt;&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;Terminated by the organiser before completion.&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;&lt;b&gt;entry&lt;/b&gt; / notifyMembers; releaseHolds&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;'&gt;C&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;'&gt;&lt;b&gt;Planning&lt;/b&gt; &lt;i&gt;(composite)&lt;/i&gt;&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;' colspan='2'&gt;Encloses S1 to S7, so a single &lt;i&gt;cancelTrip&lt;/i&gt; transition covers all seven planning substates.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;strokeColor=#1e1e1e;fontColor=#1e1e1e;text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1200" height="900" as="geometry"/></mxCell><mxCell id="stt-v4" value="&lt;div style='font-size:17px;font-weight:bold;margin-bottom:6px;'&gt;Task 4.3: Events that trigger transitions&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:15px;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:5%;'&gt;#&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:20%;'&gt;From&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font-weight:bold;width:20%;'&gt;Event&lt;/td&gt;&lt;td style='border:1px solid #495057;padding:5px 8px;vertical-align:top;background:#e9ecef;font