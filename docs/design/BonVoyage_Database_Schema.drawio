<mxfile host="app.diagrams.net" agent="BonVoyage Design Lab" version="24.0.0"><diagram name="Database ER diagram" id="erd"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4160" pageHeight="1781" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;BonVoyage: Database Schema (ER diagram)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#1e1e1e;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2400" height="40" as="geometry"/></mxCell><mxCell id="t-2" value="PostgreSQL schema as defined in packages/db/src/schema (Drizzle ORM), migration 0000_init. 26 tables. Crow's foot notation: the FK side shows &quot;many&quot; (or &quot;zero or one&quot; where the FK column is unique); the referenced side shows &quot;exactly one&quot; (or &quot;zero or one&quot; where the FK column is nullable). Every money column is whole rupees (_inr), distances in km, durations in minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#1e1e1e;fontSize=15;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2600" height="50" as="geometry"/></mxCell><mxCell id="lg-3" value="" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillStyle=solid;fillColor=#fff9db;strokeColor=#1e1e1e;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1460" height="170" as="geometry"/></mxCell><mxCell id="t-4" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColo