# Local Postgres (docker compose, not a secret)
DATABASE_URL=postgres://bonvoyage:bonvoyage@localhost:5432/bonvoyage
# Throwaway test database used by integration tests (docker compose, not a secret)
TEST_DATABASE_URL=postgres://bonvoyage:bonvoyage@localhost:5433/bonvoyage_test
# Secret used by Better Auth to sign sessions (set a long random value in .env)
BETTER_AUTH_SECRET=
# Public URL of the web app
APP_URL=http://localhost:5173
# Port the API listens on
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# on = call live third-party APIs, off = fixtures only
LIVE_APIS=off
# Gemini API key from Google AI Studio (leave empty unless you need live itinerary text)
GEMINI_API_KEY=
# Gemini model id (never hard-code it)
GEMINI_MODEL=gemini-3.8-flash
# Password for demo seed users
SEED_DEMO_PASSWORD=
